# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored and never committed.
# Also set these same values in Vercel → Project → Settings → Environment Variables
# (Production + Preview + Development), then Redeploy.

# PIN that unlocks /admin in the browser AND is checked server-side on every save.
ADMIN_PIN=change-me-to-a-strong-pin
NEXT_PUBLIC_ADMIN_PIN=change-me-to-a-strong-pin

# GitHub repo that stores the shared JSON files (admin commits here, Vercel redeploys).
GITHUB_REPO=kshamith/NARCI
GITHUB_BRANCH=main

# Fine-grained personal access token, scope: only kshamith/NARCI, Contents: read + write.
# NEVER commit this. NEVER prefix with NEXT_PUBLIC_.
GITHUB_TOKEN=paste-new-token-here
